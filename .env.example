# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.
PORT=3000
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/novasalud
# true solo si tu base de datos en la nube lo exige (Neon, Render, Railway)
DATABASE_SSL=false
# Texto largo y aleatorio. Ejemplo para generarlo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo
# Dominios del ERP y de la tienda, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
